{
  "manifest_version": 3,
  "name": "AutoMeet",
  "version": "1.0.0",
  "description": "Joins your scheduled Google Meet and Zoom meetings with camera and microphone off, and can leave at a time you choose.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AutoMeet",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "identity",
    "identity.email",
    "notifications",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/common.js",
        "src/content/meet.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zoom.us/*",
        "https://*.zoomgov.com/*"
      ],
      "js": [
        "src/content/common.js",
        "src/content/zoom.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "src/content/common.js",
        "src/content/google-signin.js"
      ],
      "run_at": "document_idle"
    }
  ]
}